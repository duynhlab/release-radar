{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    // Load-bearing: scripts/*.ts run under bare `node scripts/x.ts`, and Node's
    // native type stripping does no extension resolution — every specifier it
    // follows must be a literal ./file.ts.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,

    "paths": { "@/*": ["./src/*"] }
  },
  // tests/ has its own tsconfig, which relaxes noUncheckedIndexedAccess.
  "include": ["src/**/*.ts", "src/**/*.tsx", "scripts/**/*.ts", "*.ts"],
  "exclude": ["node_modules", ".output", "dist", ".wrangler", "tests"]
}
