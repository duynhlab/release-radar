# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.DS_Store
.open-next/
.dev.vars

# cloudflare/opennext artifacts
.wrangler/
cloudflare-env.d.ts

# internal planning notes (kept local only)
docs/release-radar-plan.txt
ke-hoach-release-radar-greenfield.txt

# e2e audit artifacts: the text contract is committed, the captures are not.
# Screenshots/traces/HAR are large and regenerable — the baseline set can be
# rebuilt from the legacy-opennext tag. Force-add only curated diffs needed for
# a specific review.
artifacts/e2e/**/*.png
artifacts/e2e/**/*.har
artifacts/e2e/**/*.zip
artifacts/e2e/**/trace/

# tanstack start / vite
.output/
.tanstack/
dist/
src/generated/
src/routeTree.gen.ts
public/release-notes/
worker-configuration.d.ts
