    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.44.0",
    "octokit": "^5.0.5",
    "radix-ui": "^1.4.3",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "4.3.3",
