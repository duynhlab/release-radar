    "sync": "node scripts/sync-releases.ts",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@tanstack/markdown": "0.0.13",
    "@tanstack/react-router": "1.170.35",
    "@tanstack/react-start": "1.168.52",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.2",
    "lucide-react": "1.44.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.7",
    "@cloudflare/vitest-pool-workers": "0.22.0",
