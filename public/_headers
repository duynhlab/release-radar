# Cloudflare Workers Assets header rules.
#
# NOT VERIFIABLE WITH `pnpm preview`: vite preview does not implement _headers,
# so no rule here — not even the asset cache ones — shows up locally. Confirmed
# by serving a probe header and seeing it absent on every path. These must be
# checked on a deployed preview with `curl -I`, which is the Phase 5 exit gate.
#
# Setting them from the app instead does not work either: every HTML page is
# prerendered and served by Workers Assets, so a route loader runs at build
# time and never touches the response. _headers is the right mechanism for a
# fully prerendered site.
#
# Threat model note: the app has no auth, session, database or user-submitted
# content. The one hostile input is third-party release-note markdown, and CSP
# is defence in depth against it, NOT the primary control — that is the parser
# running with allowHtml:false, so notes cannot express HTML at all.
#
# script-src needs 'unsafe-inline' because TanStack Start emits a per-page
# inline hydration payload: it differs across all 77 pages, so hashing is out,
# and a static file cannot issue nonces. The directives doing real work here are
# frame-ancestors, object-src, base-uri and form-action.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()

# Vite fingerprints these, so they are safe to cache forever.
/assets/*
  Cache-Control: public,max-age=31536000,immutable

# Regenerated by the twice-daily sync; a short TTL stops a stale note outliving
# the page that links to it.
/release-notes/*
  Cache-Control: public,max-age=300,must-revalidate
